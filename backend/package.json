{
  "name": "crypto-payments-backend",
  "version": "1.0.0",
  "description": "Express API server for crypto payment gateway with Supabase integration",
  "main": "api-server.js",
  "scripts": {
    "start": "node api-server.js",
    "dev": "npm run db:init && nodemon api-server.js",
    "db:init": "node init-database.js",
    "logs": "tail -f api-server.log",
    "clean": "rm -f api-server.log server.log *.out",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage"
  },
  "keywords": [
    "express",
    "api",
    "cryptocurrency",
    "payment-processing",
    "supabase"
  ],
  "author": "ZC82531",
  "license": "MIT",
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.47.0",
    "@supabase/supabase-js": "^2.44.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  }
}
